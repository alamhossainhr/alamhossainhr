{
  "version": 2,
  "functions": {
    "config/wsgi.py": {
      "includeFiles": "templates/**",
      "excludeFiles": "{staticfiles/**,static/**,media/**,*.sql,venv/**,.venv/**}"
    }
  },
  "builds": [
    {
      "src": "config/wsgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "staticfiles"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "config/wsgi.py"
    }
  ]
}